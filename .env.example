# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://enews:enews_dev_password@localhost:5432/enews?schema=public"
REDIS_URL="redis://localhost:6379"          # reserved: rate limiting is in-memory until a Redis limiter is added
APP_URL="http://localhost:3000"             # used for CSRF origin checks and email links; use https:// in production

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Protects POST /api/v1/internal/jobs/publish-scheduled (scheduled publishing). Leave empty to disable the endpoint.
# Generate like the JWT secrets above (min 32 chars).
CRON_SECRET=""

# Set to 1 ONLY when running behind your own reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# Dev seed only (12+ chars). The seed refuses to run when NODE_ENV=production.
SEED_DEV_PASSWORD=""

# Where uploaded images are stored (local disk). Use a persistent volume in production, or replace LocalDiskStorage with S3-compatible storage.
MEDIA_DIR="./uploads"

# Optional branding / contact
NEXT_PUBLIC_SITE_NAME="E News"
NEXT_PUBLIC_CONTACT_EMAIL=""

# Integration tests only: a DISPOSABLE database (tables are truncated on every run).
# TEST_DATABASE_URL="postgresql://enews:enews_dev_password@localhost:5432/enews_test"

# Mail provider. "console" (default) only logs mail: fine for development, and campaigns refuse to "send" through it in production.
# For real delivery use resend (https://resend.com); MAIL_FROM must be an address on a domain you have verified there.
MAIL_PROVIDER=console
RESEND_API_KEY=""
MAIL_FROM="E News <news@example.com>"
